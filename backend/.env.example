# DLT backend — environment template.
# Copy to .env and fill in real values for your environment.
# .env is gitignored; .env.example is committed and must never contain secrets.

# ---- Core ----
NODE_ENV=development
PORT=3000

# PostgreSQL 15+. Local dev uses a Docker container (see project setup notes).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dlt_dev

# Local-development ONLY. Lets the backend boot while connected as a superuser
# instead of the least-privileged dlt_app role. NEVER set this in production.
ALLOW_AUDIT_PRIVILEGE=i-understand-the-risk

# ---- Email ----
# memory   -> no external calls, messages captured in an in-process outbox (dev/test)
# api      -> requires EMAIL_API_URL + EMAIL_API_KEY below
EMAIL_TRANSPORT=memory
# EMAIL_API_URL=
# EMAIL_API_KEY=
# EMAIL_FROM=no-reply@dlt.co.in
# EMAIL_FROM_NAME=DLT

# ---- Razorpay ----
# The server refuses to boot unless all three are present.
# Real Razorpay TEST-MODE credentials must be supplied out of band.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ---- Optional tuning (defaults shown) ----
# PGPOOL_MAX=10
# PGSTATEMENT_TIMEOUT=10000
# REPORTING_LEAD_MIN=15
# GUEST_HOLDS_PER_IP=12
# GUEST_HOLD_IP_WINDOW_MIN=10
# GUEST_HOLD_CEILING_PCT=40
