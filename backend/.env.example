# DLT backend — environment template.
# Copy to .env and fill in real values for your environment.
# .env is gitignored; .env.example is committed and must never contain secrets.

# ---- Core ----
NODE_ENV=development
PORT=3000

# PostgreSQL 15+. Local dev uses a Docker container (see project setup notes).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dlt_dev

# Local-development ONLY. Lets the backend boot while connected as a superuser
# instead of the least-privileged dlt_app role. NEVER set this in production.
ALLOW_AUDIT_PRIVILEGE=i-understand-the-risk

# ---- Email ----
# EMAIL_TRANSPORT=memory -> no external calls, captured in an in-process
# outbox (dev/test only — this is the ONLY value email/index.ts checks by
# name). For production, leave EMAIL_TRANSPORT unset/removed.
#
# Two real transports exist; RESEND_API_KEY takes priority if both are set.
# See PRODUCTION_DEPLOYMENT.md §3 for the full setup of each.
EMAIL_TRANSPORT=memory

# -- Option A: Resend (HTTPS API — REQUIRED on Railway) --
# Railway firewalls outbound SMTP (25/465/587/2525) entirely below the Pro
# plan, so Gmail SMTP below cannot deliver from a Railway-hosted deploy
# regardless of DNS/timeout tuning — confirmed against Railway's own docs
# (docs.railway.com/networking/outbound-networking). Resend speaks plain
# HTTPS, which Railway never blocks, and is Railway's own recommended
# provider. Get a key at resend.com -> API Keys. EMAIL_FROM must be an address
# on a domain verified in Resend; onboarding@resend.dev is test-only and cannot
# send production email to arbitrary student addresses.
# RESEND_API_KEY=<starts with re_ — never commit this value; .env is
#   gitignored, this file is the template, not the secret>

# -- Option B: SMTP (Gmail — smtp.gmail.com, 587, STARTTLS) --
# Local dev, or any non-Railway host with unrestricted outbound SMTP.
# Presence of HOST + USER + PASS switches this on if RESEND_API_KEY above is
# not set (leave EMAIL_TRANSPORT unset/removed).
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=<the Gmail address>
# EMAIL_SMTP_PASS=<a Gmail App Password — NOT the account password; Google
#   Account -> Security -> 2-Step Verification -> App passwords. Requires
#   2-Step Verification to be enabled on the account. Never commit this
#   value — .env is gitignored; this file is the template, not the secret.>

# -- Shared by both transports --
# EMAIL_FROM=no-reply@dlt.co.in     # Resend: required, and the domain must be
#   verified in Resend. SMTP: defaults to EMAIL_SMTP_USER if unset.
# EMAIL_FROM_NAME=DLT

# ---- Razorpay ----
# The server refuses to boot unless all three are present.
# Real Razorpay TEST-MODE credentials must be supplied out of band.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ---- Optional tuning (defaults shown) ----
# PGPOOL_MAX=10
# PGSTATEMENT_TIMEOUT=10000
# REPORTING_LEAD_MIN=15
# GUEST_HOLDS_PER_IP=12
# GUEST_HOLD_IP_WINDOW_MIN=10
# GUEST_HOLD_CEILING_PCT=40
