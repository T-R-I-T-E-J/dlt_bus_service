# DLT backend — environment template.
# Copy to .env and fill in real values for your environment.
# .env is gitignored; .env.example is committed and must never contain secrets.

# ---- Core ----
NODE_ENV=development
PORT=3000

# PostgreSQL 15+. Local dev uses a Docker container (see project setup notes).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dlt_dev

# Local-development ONLY. Lets the backend boot while connected as a superuser
# instead of the least-privileged dlt_app role. NEVER set this in production.
ALLOW_AUDIT_PRIVILEGE=i-understand-the-risk

# ---- Email ----
# EMAIL_TRANSPORT=memory -> no external calls, captured in an in-process
# outbox (dev/test only — this is the ONLY value email/index.ts checks by
# name). For production, leave EMAIL_TRANSPORT unset/removed.
#
# Two real transports exist; SMTP takes priority if both are set.
# See PRODUCTION_DEPLOYMENT.md §3 for the full Gmail SMTP setup.
EMAIL_TRANSPORT=memory

# -- Option A: SMTP (Gmail configured — smtp.gmail.com, 587, STARTTLS) --
# Presence of HOST + USER + PASS switches this on, regardless of
# EMAIL_TRANSPORT's value above (leave EMAIL_TRANSPORT unset/removed).
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=<the Gmail address>
# EMAIL_SMTP_PASS=<a Gmail App Password — NOT the account password; Google
#   Account -> Security -> 2-Step Verification -> App passwords. Requires
#   2-Step Verification to be enabled on the account. Never commit this
#   value — .env is gitignored; this file is the template, not the secret.>

# -- Option B: generic HTTP provider API (SendGrid/Postmark/SES/etc.) --
# Presence of BOTH switches this on if SMTP above is not configured. The
# request body httpTransport() sends is a generic placeholder shape that
# still needs adjusting to whichever real provider is actually chosen.
# EMAIL_API_URL=
# EMAIL_API_KEY=

# -- Shared by both transports --
# EMAIL_FROM=no-reply@dlt.co.in     # SMTP: defaults to EMAIL_SMTP_USER if unset
# EMAIL_FROM_NAME=DLT

# ---- Razorpay ----
# The server refuses to boot unless all three are present.
# Real Razorpay TEST-MODE credentials must be supplied out of band.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ---- Optional tuning (defaults shown) ----
# PGPOOL_MAX=10
# PGSTATEMENT_TIMEOUT=10000
# REPORTING_LEAD_MIN=15
# GUEST_HOLDS_PER_IP=12
# GUEST_HOLD_IP_WINDOW_MIN=10
# GUEST_HOLD_CEILING_PCT=40
